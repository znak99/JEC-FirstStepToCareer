// 커밋되는 공통 설정. 개인 값은 Local.xcconfig에서 덮어쓴다.
APP_BUNDLE_ID = cloud.znak99.FirstStepToCareer
API_BASE_URL = https:/$()/first-step-to-career-api.znak99.cloud

SDKROOT = iphoneos
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
TARGETED_DEVICE_FAMILY = 1
IPHONEOS_DEPLOYMENT_TARGET = 18.0
SWIFT_VERSION = 6.0
CODE_SIGN_STYLE = Automatic
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
SWIFT_EMIT_LOC_STRINGS = YES
ENABLE_USER_SCRIPT_SANDBOXING = YES

// Apple 로그인. 유료 Apple Developer Program 계정으로 빌드할 때만 Local.xcconfig에서 YES로 켠다
APPLE_SIGN_IN_ENABLED = NO
APPLE_SIGN_IN_ENTITLEMENTS_YES = Config/AppleSignIn.entitlements
APPLE_SIGN_IN_ENTITLEMENTS_NO =
CODE_SIGN_ENTITLEMENTS = $(APPLE_SIGN_IN_ENTITLEMENTS_$(APPLE_SIGN_IN_ENABLED))

#include? "Local.xcconfig"
